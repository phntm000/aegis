<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Aegis</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Aegis uses the camera to scan QR codes when adding contacts. Scans are processed on-device and never uploaded.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Aegis uses the microphone for voice notes and end-to-end encrypted voice and video calls.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Aegis needs photo library access so you can share photos. Files are encrypted on-device before upload.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Aegis uses the local network to reach contacts nearby and to sync without the internet in LAN-only mode.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Aegis uses Face ID to lock the app. Biometric data never leaves your device.</string>
	<!-- Export compliance: Aegis is free, open-source, publicly available
	     mass-market encryption software (X3DH + Double Ratchet + AES-GCM,
	     all standard published algorithms). Claimed exempt from an ERN
	     under EAR mass-market provisions; see docs/EXPORT_COMPLIANCE.md.
	     Do not flip this without re-reading that doc. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
